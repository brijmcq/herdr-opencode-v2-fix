name: Tests

on:
  push:
  pull_request:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - uses: actions/setup-node@v4
        with:
          node-version: "24"
      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: "1.4.2"
      - name: Check installer safety
        run: python3 -m unittest test_manage.py
      - name: Test real socket reporting
        run: node regression.mjs
      - name: Test terminal plugin lifecycle
        run: bun test herdr-tui-session.test.ts
